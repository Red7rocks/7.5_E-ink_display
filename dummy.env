desktop_name = ""	#tailscale friendly name here too
server_name = ""	#I use tailscale for my devices, so I provide a friendly name here such as 'james-server'
server_username = ""	#Your personal login user for your server, ssh key access must be setup
latitude = 
longitude = 
printer_IP = ""        	  # your printer's LAN IP
printer_ACCESS_CODE = ""  # from Settings > Network > Access Code
printer_SERIAL = ""
main_font = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"			# I included the fonts I use here, 
condensed_font = "/usr/share/fonts/truetype/dejavu/DejaVuSansCondensed-Bold.ttf"	# they may need to be manually installed on your side 
weather_font = "/usr/share/fonts/truetype/weathericons/weathericons.ttf"
